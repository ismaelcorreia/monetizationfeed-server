# ── Scheduler ─────────────────────────────────────────────────
INGESTION_CRON=0 6 * * *
DISCOVERY_CRON=0 2 * * 0
AI_PROCESSING_INTERVAL=300

# ── App ───────────────────────────────────────────────────────
LOG_LEVEL=INFO
DISCOVERY_TERMS=Angola notícias,Africa business news,global economy news,technology Africa
